# 5am9t1.com on Bluehost (Apache). GitHub Pages did these three things by itself.
#
# The document root is public_html/5am9t1 (measured 2026-09-23), so this file no longer
# governs neuroloop100.com. The rules stay scoped to the 5am9t1.com host anyway: if the
# file is ever copied to public_html/, unscoped rules would send http://neuroloop100.com
# to https://5am9t1.com (measured on a local Apache, 2026-09-22).

<If "%{HTTP_HOST} =~ /^(www\.)?5am9t1\.com$/i">
  # 1. Our own not-found page
  ErrorDocument 404 /404.html

  # 3. Cache media and assets; always re-check pages
  <IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType video/mp4 "access plus 30 days"
  </IfModule>
</If>

# 2. Always HTTPS, and one host name (5am9t1.com, no www). Only for 5am9t1.com.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^(www\.)?5am9t1\.com$ [NC]
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://5am9t1.com%{REQUEST_URI} [L,R=301]
</IfModule>

# app-ads.txt, robots.txt, llms.txt and sitemap.xml are served as plain files from this folder.
